{
  "name": "tiny-stack",
  "private": true,
  "type": "module",
  "workspaces": ["api", "web"],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "db:push": "bun run --filter api db:push",
    "db:studio": "bun run --filter api db:studio"
  },
  "bun-create": {
    "start": "docker compose up -d --wait && bun db:push && bun dev"
  }
}
